# Telegram bot token from @BotFather (also enable Inline Mode there)
BOT_TOKEN=123456:ABCDEF

# Your numeric Telegram user id (get it from @userinfobot). The bot will
# DM you uploaded files so we can store their Telegram file_id.
ADMIN_CHAT_ID=123456789

# Login for the web control panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random string used to sign the session cookie
SESSION_SECRET=replace-with-random-string

# Optional
PORT=8000

# DATABASE_URL and UPLOAD_DIR are intentionally NOT set here. In Docker the
# Dockerfile points them at /data/... (the persistent volume). On the host
# (no Docker) config.py falls back to ./sounds.db and ./uploads. Setting
# them here would override the Docker defaults and silently put data
# inside the container filesystem, which is wiped on `compose down`.
# Only uncomment to override on purpose.
# DATABASE_URL=sqlite+aiosqlite:///./sounds.db
# UPLOAD_DIR=./uploads
